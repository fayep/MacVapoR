# Copy to release.env (ignored by git) to sign and notarize releases with your own Developer ID.
# IDENTITY is a name from `security find-identity -v -p codesigning`; NOTARY_PROFILE is the
# keychain profile saved by `xcrun notarytool store-credentials`.
IDENTITY="Developer ID Application: Your Name (TEAMID)"
NOTARY_PROFILE="your-notary-profile"
