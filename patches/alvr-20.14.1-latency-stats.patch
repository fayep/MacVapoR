 const FULL_REPORT_INTERVAL: Duration = Duration::from_millis(500);
 const EPS_INTERVAL: Duration = Duration::from_micros(1);
 
+// Each stage of the pipeline latency, summed over the frames since the last
+// alvr_get_latency_stats, for a server without the dashboard (which gets the same numbers
+// per frame in GraphStatistics events, which the session log leaves empty).
+const LATENCY_STAGES: usize = 9;
+struct LatencyTotals {
+    frames: u32,
+    discarded: u32,
+    packets_lost: u32,
+    sum_s: [f64; LATENCY_STAGES],
+    max_s: [f32; LATENCY_STAGES],
+}
+static LATENCY_TOTALS: std::sync::Mutex<LatencyTotals> = std::sync::Mutex::new(LatencyTotals {
+    frames: 0,
+    discarded: 0,
+    packets_lost: 0,
+    sum_s: [0.0; LATENCY_STAGES],
+    max_s: [0.0; LATENCY_STAGES],
+});
+
+/// Means and maxima in ms, in pipeline order: total, game (tracking received to frame
+/// present), server compositor (present to composed), encoder, network, decoder, decoder
+/// queue, client compositor, vsync queue.
+#[repr(C)]
+pub struct AlvrLatencyStats {
+    pub frames: u32,
+    pub discarded: u32,
+    pub packets_lost: u32,
+    pub mean_ms: [f32; LATENCY_STAGES],
+    pub max_ms: [f32; LATENCY_STAGES],
+}
+
+/// Fills out with the latencies of the frames the client reported since the last call, and
+/// starts again. False if out is null.
+#[no_mangle]
+pub extern "C" fn alvr_get_latency_stats(out: *mut AlvrLatencyStats) -> bool {
+    if out.is_null() {
+        return false;
+    }
+    let mut t = LATENCY_TOTALS.lock().unwrap();
+    let n = t.frames.max(1) as f64;
+    let stats = AlvrLatencyStats {
+        frames: t.frames,
+        discarded: t.discarded,
+        packets_lost: t.packets_lost,
+        mean_ms: t.sum_s.map(|s| (s / n * 1000.) as f32),
+        max_ms: t.max_s.map(|s| s * 1000.),
+    };
+    unsafe { out.write(stats) };
+    *t = LatencyTotals {
+        frames: 0,
+        discarded: 0,
+        packets_lost: 0,
+        sum_s: [0.0; LATENCY_STAGES],
+        max_s: [0.0; LATENCY_STAGES],
+    };
+    true
+}
