@@ -562,3 +562,30 @@ pub unsafe extern "C" fn alvr_restart() {
 pub unsafe extern "C" fn alvr_shutdown() {
     SERVER_CORE_CONTEXT.write().take();
 }
+
+/// Game audio comes from the caller through alvr_send_game_audio() at this sample rate, instead of
+/// being recorded from a device; 0 goes back to recording. Takes effect from the next connection.
+#[no_mangle]
+pub extern "C" fn alvr_set_external_game_audio(sample_rate: u32) {
+    crate::connection::EXTERNAL_GAME_AUDIO_RATE.store(sample_rate, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// Queues interleaved stereo 16-bit samples to stream as game audio. At most about 200 ms is kept,
+/// so audio given while nothing is streaming does not pile up.
+#[no_mangle]
+pub unsafe extern "C" fn alvr_send_game_audio(samples: *const i16, frame_count: u64) {
+    let rate = crate::connection::EXTERNAL_GAME_AUDIO_RATE.load(std::sync::atomic::Ordering::Relaxed);
+    if samples.is_null() || frame_count == 0 || rate == 0 {
+        return;
+    }
+    let samples = std::slice::from_raw_parts(samples, frame_count as usize * 2);
+    let bytes = samples.iter().flat_map(|s| s.to_le_bytes()).collect::<Vec<u8>>();
+    let max_bytes = rate as usize * 4 / 5;
+    let Ok(mut queue) = crate::connection::EXTERNAL_GAME_AUDIO.lock() else {
+        return;
+    };
+    queue.push_back(bytes);
+    while queue.iter().map(|b| b.len()).sum::<usize>() > max_bytes {
+        queue.pop_front();
+    }
+}
